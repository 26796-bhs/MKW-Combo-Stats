        0, "Kart"
    ),(
        1, "Bike"
    ),(
        2, "Trike"
    ),(
        3, "Mobile"
);

CREATE TABLE `Characters` (
    `HiddenID` INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,
    `Name` TEXT UNIQUE NOT NULL,
    `MiniTurbo` INTEGER,
    `SpeedOnRoad` INTEGER,
    `SpeedOffRoad` INTEGER,
    `SpeedOnWater` INTEGER,
    `Acceleration` INTEGER,
    `Weight` INTEGER,
    `HandlingOnRoad` INTEGER,
    `HandlingOffRoad` INTEGER,
    `HandlingOnWater` INTEGER,
    `ImageUrl` TEXT
);

CREATE TABLE `Vehicles` (
    `HiddenID` INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,
    `Name` TEXT UNIQUE NOT NULL,
    `VehicleType` INTEGER REFERENCES `Types`(`ID`),
    `MiniTurbo` INTEGER,
    `SpeedOnRoad` INTEGER,
    `SpeedOffRoad` INTEGER,
    `SpeedOnWater` INTEGER,
    `Acceleration` INTEGER,
    `Weight` INTEGER,
    `HandlingOnRoad` INTEGER,
    `HandlingOffRoad` INTEGER,
    `HandlingOnWater` INTEGER,
    `ImageUrl` TEXT
);

CREATE TABLE `Maps` (
    `HiddenID` INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,
    `Name` TEXT UNIQUE NOT NULL,
    `Road` FLOAT,
    `OffRoad` FLOAT,
    `Water` FLOAT,
    `BestCharacterSpeed` INTEGER REFERENCES `Characters`(`HiddenID`),
    `BestVehicleSpeed` INTEGER REFERENCES `Vehicles`(`HiddenID`),
    `BestCharacterTurbo` INTEGER REFERENCES `Characters`(`HiddenID`),
    `BestVehicleTurbo` INTEGER REFERENCES `Vehicles`(`HiddenID`),
    `ImageUrl` TEXT
);

CREATE TABLE `Cups` (
    `HiddenID` INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,
    `Name` TEXT UNIQUE NOT NULL,
    `Course1` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Course2` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Course3` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Course4` INTEGER REFERENCES `Maps`(`HiddenID`)
);

CREATE TABLE `Rally` (
    `HiddenID` INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,
    `Name` TEXT UNIQUE NOT NULL,
    `StartingPoint` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Checkpoint1` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Checkpoint2` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Checkpoint3` INTEGER REFERENCES `Maps`(`HiddenID`),
    `Checkpoint4` INTEGER REFERENCES `Maps`(`HiddenID`),
    `FinalCourse` INTEGER REFERENCES `Maps`(`HiddenID`)
);

