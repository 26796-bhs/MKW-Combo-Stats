SELECT * FROM "table-name";


CREATE TABLE `Characters` (
    `Name` TEXT PRIMARY KEY UNIQUE NOT NULL,
    `SpeedOnRoad` INTEGER,
    `SpeedOffRoad` INTEGER,
    `SeedOnWater` INTEGER,
    `Acceleration` INTEGER,
    `Mini-turbo` INTEGER,
    `Weight` INTEGER,
    `HandlingOnRoad` INTEGER,
    `HandlingOffRoad` INTEGER,
    `HandlingOnWater` INTEGER
    );

CREATE TABLE `Vehicles` (
    `Name` TEXT PRIMARY KEY UNIQUE NOT NULL,
    `VehicleType` TEXT,
    `SpeedOnRoad` INTEGER,
    `SpeedOffRoad` INTEGER,
    `SeedOnWater` INTEGER,
    `Acceleration` INTEGER,
    `Mini-turbo` INTEGER,
    `Weight` INTEGER,
    `HandlingOnRoad` INTEGER,
    `HandlingOffRoad` INTEGER,
    `HandlingOnWater` INTEGER
);

ALTER TABLE `Characters` ADD COLUMN `ImageUrl` TEXT;

ALTER TABLE `Vehicles` ADD COLUMN `ImageUrl` TEXT;

